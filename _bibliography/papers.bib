@article{Altinisik2026-wy,
  title       = {C-Türkiye: A Comprehensive Radiocarbon Dataset from Türkiye},
  author      = {Altınışık, N. Ezgi},
  abstract    = {Anatolia serves as a pivotal geographic and cultural crossroad. However, its radiocarbon record has remained fragmented across international databases and local literature. Here, I present the C-Turkey Dataset, a curated repository comprising 3,390 radiocarbon dates, including 885 dates previously absent from global datasets. A distinctive feature of this dataset is its systematic focus on human skeletal remains. By providing detailed annotations for directly dated skeletons, where applicable, linked ancient DNA (aDNA) identifiers. C-Turkey bridges the gap between chronometric data and bioarchaeological research. This integration prevents redundant sampling of finite biological remains and facilitates high-resolution population history reconstructions. Three key approaches were employed in dataset preparation: i) computational extraction and cleaning using the C14bazaar tool, ii) if possible, manual cross-verification of original primary sources to ensure data integrity, and iii) the systematic inclusion of recent literature and Turkish-language publications often inaccessible to the global scientific community. As an open-access resource, C-Turkey promotes academic equity and provides a robust chronometric foundation for the multi-disciplinary study of the Near East.},
  journal     = {Journal of Open Archaeology Data},
  publisher   = {Ubiquity Press},
  volume      = {14},
  number      = {17},
  month       = aug,
  year        = {2026},
  bibtex_show = {true},
  doi         = {10.5334/joad.213},
  selected    = {true}
}

@article{Ozbal2026-td,
  title       = {Diet and Mobility in Byzantine Western Anatolia: Carbon and Nitrogen Isotopic Ratios and Ancient {DNA} Evidence from Barcın Höyük and Kadıkalesi Anaia},
  author      = {Özbal, Rana and Büyükkarakaya, Ali Metin and Uysal, Gülfem and Bütün, Erge and Gerritsen, Fokke and Akbaba, Ali and Altınışık, N. Ezgi and Somel, Mehmet},
  abstract    = {This study presents the integrated results of stable carbon (δ13C) and nitrogen (δ15N) isotope and aDNA analyses, conducted to examine dietary and mobility practices in two mid- to late Byzantine communities in western Anatolia: the coastal cosmopolitan site of Kadıkalesi Anaia and the rural inland settlement of Barcın Höyük. Isotopic data from thirty-eight individuals indicate that both populations primarily consumed terrestrial C₃-based resources. At Kadıkalesi, δ15N values show greater variability, suggesting more differentiated access to animal protein sources, whereas the rural community at Barcın Höyük exhibits isotopic homogeneity, consistent with more uniform dietary practices and an equitable access to food. Kadıkalesi also shows intra-site dietary variation by age and sex, while Barcın is again more homogeneous. At Barcın, aDNA results indicate a predominant local genetic continuity, suggesting a stable population; a single instance of external ancestry is attested by a male individual with affinities to western populations, particularly from eastern Europe, in line with historical military resettlement patterns (stratiotika ktemata). By integrating isotopic and genomic evidence, this study demonstrates how ancestry and mobility shaped dietary habits, offering insights into the interplay of urbanism, mobility, and social organization in the Byzantine period.},
  journal     = {European Journal of Archaeology},
  publisher   = {Cambridge University Press},
  volume      = {29},
  number      = {2},
  pages       = {202--222},
  month       = may,
  year        = {2026},
  doi         = {10.1017/eaa.2025.10027},
  bibtex_show = {true}
}

@incollection{Altinisik2026-urartu,
  title       = {Unveiling the Population Dynamics of the {Urartian} Kingdom: Integrating Genetic and Archaeological Evidence},
  author      = {Altınışık, N. Ezgi and Özer, Füsun and Erdal, Yılmaz Selim},
  abstract    = {The Urartian kingdom (ninth–seventh centuries BC), a major political power in the ancient Near East, emerged in the challenging highland environment of eastern Anatolia. Despite its cultural and political significance, the biological origins and demographic structure of the Urartian population have remained poorly understood due to the scarcity of direct evidence from human remains. This study integrates ancient genomic data with archaeological evidence to explore the population history, genetic diversity, and mobility patterns within the Urartian realm. By co-analysing published genome-wide data from Urartian and pre-Urartian individuals in eastern Anatolia, the South Caucasus, and north-western Iran, we trace genetic continuities and interactions across the region. Principal Component Analysis and formal f-statistics reveal strong regional genetic continuity between pre-Urartian and Urartian populations, indicating that the rise of the Urartian kingdom did not result from a major demographic replacement. Nonetheless, isolated outlier individuals suggest limited mobility between Urartian centres, possibly associated with political or economic integration. The genetic affinity between eastern Anatolian Urartians and southern populations aligns with archaeological evidence of Neo-Assyrian interaction. Analyses of runs of homozygosity (ROH) further indicate a genetically diverse founding population, with no evidence for recent inbreeding. Together, these findings demonstrate that the Urartian kingdom arose from largely local populations that maintained regional continuity while integrating influences from neighbouring societies. Our results highlight the value of combining genetic and archaeological data in reconstructing the demographic and sociopolitical dynamics of ancient highland polities.},
  booktitle   = {Urartu and Beyond: Improvement and Interaction in the Iron Age Highlands},
  editor      = {Işıklı, Mehmet and Çavuşoğlu, Rafet and Ocak, Hazal and Demirtaş, Dilara and Aslan, Alper and Bailey, Jan},
  publisher   = {Brepols},
  address     = {Antwerp},
  pages       = {277--290},
  year        = {2026},
  doi         = {10.1484/M.ARAXES-EB.5.151056},
  bibtex_show = {true}
}

